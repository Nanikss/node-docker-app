{
  "root": true,
  "extends": "eslint:recommended",
  "env": { "node": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "prefer-const": "error",
    "eqeqeq": "error"
  },
  "overrides": [
    { "files": ["test/**/*.js"], "env": { "jest": true } }
  ]
}
